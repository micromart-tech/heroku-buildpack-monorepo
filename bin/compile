#!/usr/bin/env bash

# Ensure wildcards in globs match dotfiles too.
shopt -s dotglob

indent() {
    sed -u 's/^/      /'
}

BUILD_DIR="$1"
CACHE_DIR="$2"
ENV_DIR="$3"
STAGE="$(mktemp -d)"
VERDACCIO_PORT="4873"
VERDACCIO_REGISTRY="http://localhost:${VERDACCIO_PORT}"

# Get the buildpack directory (where this script is located)
BUILDPACK_DIR="$(dirname "$(dirname "$(readlink -f "$0")")")"

# Set up Verdaccio storage directory
VERDACCIO_STORAGE="${BUILDPACK_DIR}/verdaccio-storage"

# Install Node.js
echo "Installing Node.js..." | indent

# Check for Node.js version in package.json
if [ -f "${BUILD_DIR}/package.json" ]; then
    NODE_ENGINE=$(grep -o '"node": *"[^"]*"' "${BUILD_DIR}/package.json" | sed 's/"node": *"\([^"]*\)"/\1/' || echo "")
    if [ -n "${NODE_ENGINE}" ]; then
        echo "Found Node.js version requirement: ${NODE_ENGINE}" | indent
        # Extract major version for compatibility
        NODE_MAJOR=$(echo "${NODE_ENGINE}" | sed 's/[^0-9]*\([0-9]*\).*/\1/')
        case "${NODE_MAJOR}" in
            16) NODE_VERSION="16.20.2" ;;
            18) NODE_VERSION="18.19.0" ;;
            20) NODE_VERSION="20.11.0" ;;
            21) NODE_VERSION="21.6.2" ;;
            *) NODE_VERSION="18.19.0" ;;
        esac
    else
        NODE_VERSION="18.19.0"  # Default Node.js version
    fi
else
    NODE_VERSION="18.19.0"  # Default Node.js version
fi

echo "Installing Node.js version: ${NODE_VERSION}" | indent

NODE_DIST="node-v${NODE_VERSION}-linux-x64"
NODE_URL="https://nodejs.org/dist/v${NODE_VERSION}/${NODE_DIST}.tar.gz"

# Create Node.js directory
mkdir -p "${BUILD_DIR}/.heroku/node"

# Download and extract Node.js
cd "${BUILD_DIR}/.heroku"
curl -s "${NODE_URL}" | tar -xz
mv "${NODE_DIST}"/* node/

# Update PATH to include Node.js
export PATH="${BUILD_DIR}/.heroku/node/bin:$PATH"

echo "Node.js installed successfully" | indent
echo "Node version: $(node --version)" | indent
echo "NPM version: $(npm --version)" | indent

# Install Yarn
echo "Installing Yarn..." | indent

# Check for Yarn version in package.json
YARN_VERSION="1.22.19"  # Default Yarn version
if [ -f "${BUILD_DIR}/package.json" ]; then
    YARN_ENGINE=$(grep -o '"yarn": *"[^"]*"' "${BUILD_DIR}/package.json" | sed 's/"yarn": *"\([^"]*\)"/\1/' || echo "")
    if [ -n "${YARN_ENGINE}" ]; then
        echo "Found Yarn version requirement: ${YARN_ENGINE}" | indent
        # Extract version number
        YARN_VERSION=$(echo "${YARN_ENGINE}" | sed 's/[^0-9.]*\([0-9.]*\).*/\1/')
    fi
fi

echo "Installing Yarn version: ${YARN_VERSION}" | indent

# Create Yarn directory
mkdir -p "${BUILD_DIR}/.heroku/yarn"

# Download and install Yarn
cd "${BUILD_DIR}/.heroku/yarn"
curl -sL "https://github.com/yarnpkg/yarn/releases/download/v${YARN_VERSION}/yarn-v${YARN_VERSION}.tar.gz" -o yarn.tar.gz
tar -xzf yarn.tar.gz
mv yarn-v${YARN_VERSION}/* .
rm yarn.tar.gz

# Update PATH to include Yarn
export PATH="${BUILD_DIR}/.heroku/yarn/bin:$PATH"

echo "Yarn installed successfully" | indent
echo "Yarn version: $(yarn --version)" | indent

# Run yarn install from the root of the project first
echo "Installing dependencies with yarn..." | indent
cd "${BUILD_DIR}" || exit 1
yarn install

if [ $? -ne 0 ]; then
    echo "FAILED to install dependencies with yarn" | indent
    exit 1
fi

echo "Dependencies installed successfully" | indent

# Use Lerna to bump minor versions of all packages
echo "Bumping package versions with Lerna..." | indent
npx lerna version minor --yes --no-push --no-git-tag-version

if [ $? -ne 0 ]; then
    echo "FAILED to bump package versions with Lerna" | indent
    exit 1
fi

echo "Package versions bumped successfully" | indent

# Install Verdaccio
echo "Installing Verdaccio..." | indent
npm install -g verdaccio

if [ $? -ne 0 ]; then
    echo "FAILED to install Verdaccio" | indent
    exit 1
fi

echo "Verdaccio installed successfully" | indent

# Start Verdaccio local registry with custom config
echo "Starting Verdaccio local registry with custom config..." | indent
npx verdaccio --listen ${VERDACCIO_PORT} --config "${BUILDPACK_DIR}/verdaccio-config.yaml" &
VERDACCIO_PID=$!

# Wait for Verdaccio to start
sleep 5

# Check if Verdaccio is running
if ! curl -s "${VERDACCIO_REGISTRY}" > /dev/null; then
    echo "FAILED to start Verdaccio registry" | indent
    kill $VERDACCIO_PID 2>/dev/null
    exit 1
fi

echo "Verdaccio registry started successfully" | indent

# Use Lerna to publish packages to Verdaccio
echo "Publishing packages to Verdaccio..." | indent
npx lerna publish from-package --yes --registry=${VERDACCIO_REGISTRY}

if [ $? -ne 0 ]; then
    echo "FAILED to publish packages to Verdaccio" | indent
    kill $VERDACCIO_PID 2>/dev/null
    exit 1
fi

echo "Packages published to Verdaccio successfully" | indent

# Create tar archive of packages for runtime
echo "Creating package archive for runtime..." | indent
if [ -d "${VERDACCIO_STORAGE}" ]; then
    tar -czf "${BUILD_DIR}/verdaccio-packages.tar.gz" -C "${VERDACCIO_STORAGE}" .
    echo "Package archive created successfully" | indent
else
    echo "No Verdaccio storage to archive" | indent
fi

# Copy Verdaccio config to BUILD_DIR
echo "Copying Verdaccio config to build directory..." | indent
cp "${BUILDPACK_DIR}/verdaccio-config.yaml" "${BUILD_DIR}/verdaccio-config.yaml"
echo "Verdaccio config copied successfully" | indent

if [ ! -f "${ENV_DIR}/APP_BASE" ]; then
    echo "APP_BASE was not set. Aborting" | indent
    exit 1
fi
APP_BASE="$(cat "${ENV_DIR}/APP_BASE")"

(
    mv "${BUILD_DIR}/${APP_BASE}" "${STAGE}" &&
    rm -rf "${BUILD_DIR}"/* &&
    mv "${STAGE}/$(basename "$APP_BASE")"/* "${BUILD_DIR}"
)

if [ $? -ne 0 ]; then
    echo "FAILED to copy directory into place" | indent
    exit 1
fi

echo "Copied ${APP_BASE} to root of app successfully" | indent

# Configure .npmrc to use Verdaccio registry
echo "Configuring Verdaccio registry..." | indent
cat >> "${BUILD_DIR}/.npmrc" << EOF
registry=${VERDACCIO_REGISTRY}
@${ORG_NAME}:registry=${VERDACCIO_REGISTRY}/:_authToken=${NPM_TOKEN}
EOF

# Reinstall dependencies to use local packages
echo "Reinstalling dependencies with local packages..." | indent
yarn install

if [ $? -ne 0 ]; then
    echo "FAILED to reinstall dependencies with local packages" | indent
    exit 1
fi

echo "Dependencies reinstalled with local packages successfully" | indent

# Clean up Verdaccio process
echo "Stopping Verdaccio registry..." | indent
kill $VERDACCIO_PID 2>/dev/null
wait $VERDACCIO_PID 2>/dev/null

# Clean up temporary directories
rm -rf "${STAGE}"

echo "Build completed successfully" | indent

